# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local (page 4):    postgresql://postgres:devpassword@localhost:5432/haunted
# Hosted (page 5):   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/haunted
# DATABASE_SSL=false for a private local database without TLS (e.g. Compose).

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Run npm run auth:setup to save a username and salted password hash in .env.
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
# Only for HTTPS deployments where frontend and API are on different sites.
# Same-site hosting is preferred; browsers can block third-party cookies.
AUTH_CROSS_SITE=false

# Do NOT set PORT locally or on the host. The host sets it for you.
